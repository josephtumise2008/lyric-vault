# Form endpoint for the booking and newsletter forms.
#
# Leave blank and the site still works: submissions are validated, the success
# state is shown, and nothing is sent anywhere. Set it to a real endpoint
# (Formspree, Basin, a Netlify function, your own API…) and submissions are
# delivered with no code change.
#
# Example:
# VITE_FORM_ENDPOINT=https://formspree.io/f/yourFormId
VITE_FORM_ENDPOINT=
